-- SweeFi Behavioral Specification
-- Allium spec for s402 payment protocol: Move contracts + TypeScript adapters
-- Author: Agent 5 (Career), 2026-03-28; updated 2026-04-11 (S8, fee events, prepaid v0.2)
-- Purpose: (1) Spec-code divergence bug hunt (2) Test generation (3) Agent onboarding context (4) Verification confidence tracking

-- ==========================================================
-- ENTITIES
-- ==========================================================

entity Payment {
    payer: Address
    recipient: Address
    amount: u64 where amount > 0
    fee_micro_pct: u64 where fee_micro_pct <= 1_000_000
    fee_amount: u64

    -- Derived: fee_amount = floor(amount * fee_micro_pct / 1_000_000)
    -- Invariant: fee_amount <= amount
}

entity Invoice {
    creator: Address
    recipient: Address
    expected_amount: u64 where expected_amount > 0
    fee_micro_pct: u64 where fee_micro_pct <= 1_000_000
    fee_recipient: Address
    consumed: unconsumed | consumed

    transitions consumed {
        unconsumed -> consumed  -- pay_invoice consumes
        terminal: consumed
    }
}

entity PaymentReceipt {
    payer: Address
    recipient: Address
    amount: u64
    fee_amount: u64
    token_type: String
    timestamp_ms: u64
}

entity Mandate {
    delegator: Address
    delegate: Address
    max_per_tx: u64
    max_total: u64
    total_spent: u64
    expires_at_ms: Option<u64>
    revocation_status: active | revoked

    transitions revocation_status {
        active -> revoked
        terminal: revoked
    }
}

entity AgentMandate {
    delegator: Address
    delegate: Address
    level: L0_read_only | L1_monitor | L2_capped | L3_autonomous
    max_per_tx: u64
    daily_limit: u64
    daily_spent: u64
    weekly_limit: u64
    weekly_spent: u64
    max_total: u64
    total_spent: u64
    expires_at_ms: Option<u64>

    transitions level {
        L0_read_only -> L1_monitor
        L0_read_only -> L2_capped
        L0_read_only -> L3_autonomous
        L1_monitor -> L2_capped
        L1_monitor -> L3_autonomous
        L2_capped -> L3_autonomous
        -- NO downgrade paths. Level only increases.
    }
}

entity Escrow {
    buyer: Address
    seller: Address
    arbiter: Address
    balance: u64
    amount: u64       -- original deposit, immutable
    deadline_ms: u64
    state: active | disputed | released | refunded
    fee_micro_pct: u64 where fee_micro_pct <= 1_000_000

    transitions state {
        active -> released     -- buyer releases
        active -> refunded     -- deadline passes, anyone refunds
        active -> disputed     -- buyer or seller disputes (before deadline)
        disputed -> released   -- arbiter releases
        disputed -> refunded   -- arbiter refunds OR deadline passes
        terminal: released
        terminal: refunded
    }
}

entity StreamingMeter {
    payer: Address
    recipient: Address
    balance: u64
    rate_per_second: u64 where rate_per_second > 0
    budget_cap: u64 where budget_cap > 0
    total_claimed: u64
    last_claim_ms: u64
    active: bool
    paused_at_ms: u64
    fee_micro_pct: u64 where fee_micro_pct <= 1_000_000
}

entity PrepaidBalance {
    agent: Address
    provider: Address
    balance: u64
    rate_per_call: u64
    max_calls: u64
    claimed_calls: u64
    -- Trust-bounded: provider reports call count, agent can dispute with signed receipt
}

-- ==========================================================
-- VERIFICATION CONFIDENCE LEVELS
-- ==========================================================
-- Each invariant carries a CONFIDENCE tag indicating how rigorously it has been verified.
--
-- code-inspection    (weak)     — verified by reading the code; shares blind spots with spec author
-- mutation-tested    (strong)   — a deliberate code mutation was introduced and caught by tests
-- independent-derivation (strongest) — derived independently from a different source than the spec
--
-- Mutation testing proves tests have "teeth" — they fail when the invariant is violated.
-- Code inspection only proves internal consistency ("does code match spec?"), not external
-- correctness ("is the spec right?"). The gap between code-inspection and mutation-tested
-- is where circular reinforcement errors hide.

-- ==========================================================
-- PAYMENT INVARIANTS
-- ==========================================================

invariant PaymentSufficientFunds {
    -- CODE CHECK: payment.move:185 — assert!(payment.value() >= amount, EInsufficientPayment)
    -- VERIFIED: ✅ Checked before any transfer
    -- CONFIDENCE: code-inspection
    for p in Payment:
        p.coin_value >= p.amount
}

invariant FeeNeverExceedsAmount {
    -- CODE CHECK: math.move:54 — result = (amount * fee_micro_pct) / 1_000_000
    -- Since fee_micro_pct <= 1_000_000 and division truncates, result <= amount
    -- VERIFIED: ✅ math::calculate_fee uses u128 intermediate, caps at u64::MAX
    -- CONFIDENCE: mutation-tested (2026-04-11) — +1 to fee result caught by 4 math tests
    for p in Payment:
        p.fee_amount <= p.amount
}

invariant OverflowSafeFeeCalculation {
    -- CODE CHECK: math.move:54 — u128 intermediate arithmetic
    -- VERIFIED: ✅ (amount as u128) * (fee_micro_pct as u128) / FEE_DENOMINATOR
    -- Maximum: u64::MAX * 1_000_000 = 1.84e25 < u128::MAX (3.4e38). Safe.
    -- CONFIDENCE: code-inspection
    for p in Payment:
        p.fee_calculation_uses_u128_intermediate
}

invariant ChangeReturnedOnOverpayment {
    -- CODE CHECK: payment.move:190-193 — if payment_value > amount, split and transfer change
    -- VERIFIED: ✅ Change split happens BEFORE fee calculation
    -- CONFIDENCE: code-inspection
    for p in Payment:
        p.coin_value > p.amount implies p.change_returned = p.coin_value - p.amount
}

invariant InvoiceConsumedOnPayment {
    -- CODE CHECK: payment.move:274-284 — Invoice destructured (UID deleted)
    -- VERIFIED: ✅ Invoice is consumed by value (Move linearity), UID explicitly deleted
    -- This is Sui-idiomatic replay protection: a consumed object ID can never be reused
    -- CONFIDENCE: code-inspection
    for i in Invoice:
        i.consumed = consumed implies i.uid_deleted
}

invariant ZeroFeePreserved {
    -- CODE CHECK: math.move:53 — if (fee_micro_pct == 0) return 0
    -- VERIFIED: ✅ Explicit early return, not reliant on division behavior
    -- CONFIDENCE: code-inspection
    for p in Payment:
        p.fee_micro_pct = 0 implies p.fee_amount = 0
}

-- ==========================================================
-- MANDATE INVARIANTS
-- ==========================================================

invariant MandateTotalSpentBounded {
    -- CODE CHECK: mandate.move:161-164 — u128 comparison before debit
    -- VERIFIED: ✅ (total_spent as u128) + (amount as u128) <= (max_total as u128)
    -- CONFIDENCE: code-inspection
    for m in Mandate:
        m.total_spent <= m.max_total
}

invariant MandatePerTxBounded {
    -- CODE CHECK: mandate.move:155
    -- VERIFIED: ✅ assert!(amount <= mandate.max_per_tx)
    -- CONFIDENCE: code-inspection
    for m in Mandate:
        every_spend_amount <= m.max_per_tx
}

invariant MandateRegistryOwnershipVerified {
    -- CODE CHECK: mandate.move:142 — registry.owner == mandate.delegator
    -- VERIFIED: ✅ Prevents rogue delegate from passing empty registry
    -- This is the CRITICAL security check. Without it, revocation is bypassable.
    -- CONFIDENCE: code-inspection
    for m in Mandate:
        m.spending_checks_registry_ownership
}

invariant MandateOnlyDelegateSpends {
    -- CODE CHECK: mandate.move:147 — ctx.sender() == mandate.delegate
    -- VERIFIED: ✅
    -- CONFIDENCE: code-inspection
    for m in Mandate:
        m.spending_requires_delegate_signature
}

-- ==========================================================
-- AGENT MANDATE INVARIANTS
-- ==========================================================

invariant AgentMandateLevelOnlyIncreases {
    -- CODE CHECK: agent_mandate.move:321 — new_level > mandate.level
    -- VERIFIED: ✅ Strict > (not >=), enforced in upgrade_level
    -- CONFIDENCE: code-inspection
    for m in AgentMandate:
        m.level_transitions_are_monotonically_increasing
}

invariant AgentMandateDailyResetCorrect {
    -- CODE CHECK: agent_mandate.move:255-258 — lazy reset on first spend after 24h
    -- VERIFIED: ✅ Initialized to clock.timestamp_ms() at creation (not epoch 0)
    -- IMPORTANT: last_daily_reset_ms starts at creation time, preventing
    -- "fresh daily allowance" exploitation on old mandates
    -- CONFIDENCE: code-inspection
    for m in AgentMandate:
        m.last_daily_reset_ms >= m.created_at_ms
}

invariant AgentMandateUpdateCapsFloorCheck {
    -- CODE CHECK: agent_mandate.move:348-350
    -- VERIFIED: ✅ new caps must be >= current spent amounts
    -- Prevents: delegator sets daily_limit < daily_spent, instantly freezing agent
    -- CONFIDENCE: code-inspection
    for m in AgentMandate:
        m.updated_daily_limit >= m.daily_spent
        m.updated_weekly_limit >= m.weekly_spent
        m.updated_max_total >= m.total_spent
}

-- ==========================================================
-- ESCROW INVARIANTS
-- ==========================================================

invariant EscrowParticipantsDistinct {
    -- CODE CHECK: escrow.move:212-219
    -- VERIFIED: ✅ arbiter != seller, arbiter != buyer, buyer != seller
    -- CONFIDENCE: code-inspection
    for e in Escrow:
        e.buyer != e.seller and e.seller != e.arbiter and e.buyer != e.arbiter
}

invariant EscrowNoFeeOnRefund {
    -- CODE CHECK: escrow.move:420-424 — full balance transferred to buyer
    -- VERIFIED: ✅ No fee calculation in refund path
    -- CONFIDENCE: mutation-tested (2026-04-11) — added fee deduction to refund, caught by 2 tests
    for e in Escrow:
        e.state = refunded implies e.refund_amount = e.balance  -- full refund, zero fee
}

invariant EscrowDisputeBeforeDeadline {
    -- CODE CHECK: escrow.move:475 — assert!(now_ms < escrow.deadline_ms)
    -- VERIFIED: ✅ M-01 security fix prevents post-deadline dispute
    -- CONFIDENCE: code-inspection
    for e in Escrow:
        e.dispute_requires(clock.now < e.deadline_ms)
}

invariant EscrowGracePeriodBounded {
    -- CODE CHECK: escrow.move:482-494
    -- VERIFIED: ✅ clamp(duration * 50%, 7 days, 30 days)
    -- Grace period = max(min(original_duration * 50%, 30 days), 7 days)
    -- CONFIDENCE: code-inspection
    for e in Escrow:
        7_days <= e.dispute_grace_period <= 30_days
}

invariant EscrowPermissionlessRefundAfterDeadline {
    -- CODE CHECK: escrow.move:408 — if (now_ms >= deadline_ms) then no auth required
    -- VERIFIED: ✅ Anyone can trigger refund after deadline (prevents key-loss lockup)
    -- CONFIDENCE: code-inspection
    for e in Escrow:
        clock.now >= e.deadline_ms implies anyone_can_refund(e)
}

-- ==========================================================
-- ✅ RESOLVED FINDING: ESCROW RELEASE NOW DEADLINE-GATED
-- ==========================================================

