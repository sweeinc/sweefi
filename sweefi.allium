--   if (state == STATE_DISPUTED) {
--       assert!(sender == arbiter, ENotArbiter);
--       assert!(clock.timestamp_ms() < deadline_ms, EDeadlineReached);
--   };
--
-- The Allium spec-code divergence analysis found this bug. The fix
-- was applied the same session. Comment at line 297: "Found by Allium
-- behavioral spec (sweefi.allium, 2026-03-28)."
--
-- STATUS: CLOSED. Spec and code now agree: after deadline, only refund is valid.

-- ==========================================================
-- STREAM INVARIANTS
-- ==========================================================

invariant StreamTotalClaimedBounded {
    -- CODE CHECK: stream.move:817-822 — budget_remaining = budget_cap - total_claimed
    -- VERIFIED: ✅ Accrued amount capped at budget_remaining in calculate_accrued
    -- CONFIDENCE: mutation-tested (2026-04-11) — removed budget cap, caught after top_up test
    for s in StreamingMeter:
        s.total_claimed <= s.budget_cap
}

invariant StreamAccrualOverflowSafe {
    -- CODE CHECK: stream.move:808 — u128 intermediate: (rate * elapsed_ms) / 1000
    -- VERIFIED: ✅ Maximum: u64::MAX * u64::MAX = 3.4e38 < u128::MAX. Safe.
    -- CONFIDENCE: mutation-tested (2026-04-11) — downgraded to u64, Move arithmetic abort
    for s in StreamingMeter:
        s.accrual_calculation_uses_u128
}

invariant StreamPausePreservesAccrual {
    -- CODE CHECK: stream.move:438-443 — time-shift in resume()
    -- VERIFIED: ✅ pre_pause_elapsed = paused_at_ms - last_claim_ms
    --   last_claim_ms = now - pre_pause_elapsed (shifted backward)
    -- Prevents: pause() → resume() → close() atomic PTB attack
    -- where payer tries to erase accrued time between pause and resume
    -- CONFIDENCE: code-inspection
    for s in StreamingMeter:
        s.paused implies s.pre_pause_accrual_preserved_on_resume
}

invariant StreamDepositNotExceedBudget {
    -- CODE CHECK: stream.move:181 — assert!(deposit_value <= budget_cap)
    -- VERIFIED: ✅ H-5 guard prevents overfunding
    -- CONFIDENCE: code-inspection
    for s in StreamingMeter:
        s.initial_deposit <= s.budget_cap
}

invariant StreamClaimCappedAtBalance {
    -- CODE CHECK: stream.move:324-328 — claimable = min(accrued, balance)
    -- VERIFIED: ✅ Cannot claim more than actually deposited
    -- CONFIDENCE: code-inspection
    for s in StreamingMeter:
        s.claimable <= s.balance
}

invariant StreamRecipientCloseTimeout {
    -- CODE CHECK: stream.move:603 — now - last_activity >= timeout
    -- VERIFIED: ✅ Minimum 1 day, maximum 30 days
    -- Prevents payer-pause-and-disappear lockup attack
    -- CONFIDENCE: code-inspection
    for s in StreamingMeter:
        s.recipient_close_requires_timeout_elapsed
}

-- ==========================================================
-- PREPAID BALANCE INVARIANTS
-- ==========================================================

invariant PrepaidClaimedCallsMonotonic {
    -- CODE CHECK: prepaid.move (cumulative claimed_calls, not incremental)
    -- VERIFIED: ✅ Provider submits cumulative count; contract checks new > old
    -- CONFIDENCE: mutation-tested (2026-04-11) — removed regression guard, arithmetic underflow
    for p in PrepaidBalance:
        p.claimed_calls_only_increases
}

invariant PrepaidExtractionBounded {
    -- Rate cap * max_calls = maximum possible extraction
    -- Deposit amount is the absolute ceiling
    -- CONFIDENCE: mutation-tested (2026-04-11) — removed max_calls check, over-extraction allowed
    for p in PrepaidBalance:
        p.max_extraction = min(p.rate_per_call * p.max_calls, p.balance)
}

-- ==========================================================
-- CROSS-MODULE INVARIANTS
-- ==========================================================

invariant FeeCalculationConsistent {
    -- All modules (payment, escrow, stream, prepaid) use math::calculate_fee
    -- VERIFIED: ✅ Single shared implementation prevents copy-paste drift
    -- CODE CHECK: Each module imports sweefi::math
    -- CONFIDENCE: code-inspection
    for module in [payment, escrow, stream, prepaid]:
        module.fee_calculation = math::calculate_fee
}

invariant MinDepositOnSharedObjects {
    -- CODE CHECK: escrow.move:76, stream.move:47, prepaid.move (similar)
    -- VERIFIED: ✅ MIN_DEPOSIT = 1_000_000 prevents dust spam
    -- CONFIDENCE: code-inspection
    for shared_object in [Escrow, StreamingMeter, PrepaidBalance]:
        shared_object.initial_deposit >= 1_000_000
}

invariant AdminPauseOnCreate {
    -- CODE CHECK: escrow.move:201, stream.move:173
    -- VERIFIED: ✅ admin::assert_not_paused checked at creation
    -- NOT checked on release/refund/claim — intentional (don't lock funds during pause)
    -- CONFIDENCE: code-inspection
    for module in [escrow, stream, prepaid]:
        module.create_checks_protocol_pause
        module.release_does_not_check_pause  -- intentional: don't lock funds
}

-- ==========================================================
-- S8: CLIENT-SIDE SETTLEMENT VERIFICATION (Sui Implementation)
-- ==========================================================
-- Protocol-level spec: s402/spec/allium/s8-facilitator-accountability.allium
-- Sui implementation: packages/sui/src/s402/verify.ts

-- The s402 protocol defines an interface contract; these are the Sui-specific invariants.

invariant SuiDigestIsBlake2b256 {
    -- CODE CHECK: packages/sui/src/s402/verify.ts — computeSuiDigest()
    -- VERIFIED: ✅ blake2b(txBytes, { dkLen: 32 }) → base58 encode
    -- This is deterministic: same BCS bytes → same digest, always.
    -- CONFIDENCE: code-inspection
    for settlement in SuiSettlement:
        settlement.expectedDigest = base58(blake2b_256(settlement.signedTxBytes))
}

invariant VerifySettlementIsOffline {
    -- CODE CHECK: packages/sui/src/s402/verify.ts — verifySuiSettlement()
    -- VERIFIED: ✅ No RPC calls, no network access, no chain state
    -- Pure function: (payload, settleResponse) → SettlementVerification
    -- CONFIDENCE: code-inspection
    for verification in SettlementVerification:
        verification.requires_no_rpc_calls
        verification.requires_no_network_access
}

invariant AllClientSignedSchemesVerify {
    -- CODE CHECK: exact/client.ts, stream/client.ts, escrow/client.ts,
    --   prepaid/client.ts, unlock/client.ts — all implement verifySettlement()
    -- VERIFIED: ✅ All 5 adapters delegate to verifySuiSettlement()
    -- CONFIDENCE: code-inspection
    for scheme in [exact, stream, escrow, prepaid]:
        scheme.verifySettlement uses verifySuiSettlement(payload, settleResponse)
        scheme.verifySettlement returns { verified: true } iff expectedDigest === actualDigest
}

invariant UnlockTX2CannotVerify {
    -- CODE CHECK: unlock/client.ts — verifySettlement()
    -- VERIFIED: ✅ Returns { verified: false, reason: 'not supported' }
    -- Unlock TX2 is facilitator-constructed, client has no signed bytes to compare.
    -- CONFIDENCE: code-inspection
    for unlock_tx2 in UnlockScheme:
        unlock_tx2.verifySettlement returns { verified: false }
        unlock_tx2.verifySettlement.reason is present
}

invariant InvalidBase64DoesNotThrow {
    -- CODE CHECK: verify.ts — try/catch around base64 decode
    -- VERIFIED: ✅ Returns { verified: false, reason } instead of throwing
    -- CONFIDENCE: code-inspection
    for malformed_payload in MalformedPayloads:
        verifySuiSettlement(malformed_payload, response) returns { verified: false }
        -- MUST NOT propagate exceptions to caller
}

-- ==========================================================
-- FACILITATOR FEE EVENT VERIFICATION (DAN-279 fix)
-- ==========================================================
-- Attack vector: client builds the PTB, controls fee_micro_pct argument.
-- Malicious client sets to 0 → facilitator was blind to it before this fix.
-- Fix: Move events emit fee_micro_pct, facilitator verifies from event.

invariant StreamEventEmitsFee {
    -- CODE CHECK: stream.move — StreamCreated event has fee_micro_pct field
    -- VERIFIED: ✅ Both create() and create_with_timeout() emit fee_micro_pct
    -- CONFIDENCE: code-inspection
    for s in StreamCreated:
        s.fee_micro_pct = argument_fee_micro_pct_passed_to_create
}

invariant PrepaidEventEmitsFee {
    -- CODE CHECK: prepaid.move — PrepaidDeposited event has fee_micro_pct field
    -- VERIFIED: ✅ Both deposit() and deposit_with_receipts() emit fee_micro_pct
    -- CONFIDENCE: code-inspection
    for p in PrepaidDeposited:
        p.fee_micro_pct = argument_fee_micro_pct_passed_to_deposit
}

invariant FacilitatorVerifiesFeeFromEvent {
    -- CODE CHECK: stream/facilitator.ts, prepaid/facilitator.ts, escrow/facilitator.ts
    -- VERIFIED: ✅ All three compare emitted fee_micro_pct against bpsToMicroPercent(requirements.protocolFeeBps)
    -- IMPORTANT: Verification is from the EMITTED EVENT, not from the PTB arguments.
    -- The client controls PTB arguments. The event is the facilitator's only trustworthy source.
    -- CONFIDENCE: code-inspection
    for facilitator_verify in [StreamFacilitator, PrepaidFacilitator, EscrowFacilitator]:
        facilitator_verify.reads fee_micro_pct from dry_run emitted event
        facilitator_verify.rejects if event.fee_micro_pct != bpsToMicroPercent(requirements.protocolFeeBps)
}

-- ==========================================================
-- PREPAID v0.2: SIGNED RECEIPTS + FRAUD PROOFS
-- ==========================================================
-- In v0.1, claims are immediate (no dispute window).
-- In v0.2, claims enter a pending state. The agent has a dispute window
-- to submit a signed receipt proving the provider over-counted.

entity PrepaidReceipt {
    balance_id: Address          -- replay protection: receipt is bound to this specific balance
    call_number: u64             -- the specific call this receipt attests to
    timestamp_ms: u64
    response_hash: vector<u8>   -- hash of the API response the provider returned
    signature: Ed25519Signature  -- signed by provider_pubkey registered at deposit time
}

invariant PrepaidV2ClaimIsPending {
    -- CODE CHECK: prepaid.move:496-508 — v0.2 claim enters pending state
    -- VERIFIED: ✅ When dispute_window_ms > 0, claim() sets pending_* fields, no funds move
    -- CONFIDENCE: code-inspection
    for claim in PrepaidClaim where balance.dispute_window_ms > 0:
        claim.creates_pending_state
        claim.does_not_transfer_funds
}

invariant PrepaidDisputeWithinWindow {
    -- CODE CHECK: prepaid.move:610-613 — assert!(now < pending_ms + window)
    -- VERIFIED: ✅ Dispute must happen before window expires
    -- CONFIDENCE: code-inspection
    for dispute in PrepaidDispute:
        dispute.timestamp_ms < balance.pending_claim_ms + balance.dispute_window_ms
}

invariant PrepaidDisputeRequiresValidSignature {
    -- CODE CHECK: prepaid.move:643-648 — ed25519_verify
    -- VERIFIED: ✅ Signature must come from provider's registered pubkey
    -- CONFIDENCE: code-inspection
    for dispute in PrepaidDispute:
        dispute.signature is valid under balance.provider_pubkey
}

invariant PrepaidDisputeReceiptReplayProtection {
    -- CODE CHECK: prepaid.move:616-619 — receipt_balance_id == object::id(balance).to_address()
    -- VERIFIED: ✅ Receipt must be for THIS specific balance, not a different one
    -- CODE CHECK: prepaid.move:631-633 — receipt_call_number > balance.claimed_calls
    -- VERIFIED: ✅ Receipt must be from the CURRENT pending batch, not a prior settled one
    -- CONFIDENCE: code-inspection
    for dispute in PrepaidDispute:
        dispute.receipt.balance_id = balance.id
        dispute.receipt.call_number > balance.claimed_calls
        dispute.receipt.call_number < balance.pending_claim_count
}

invariant PrepaidDisputeFreezesBalance {
    -- CODE CHECK: prepaid.move:652-658 — disputed = true, pending state cleared
    -- VERIFIED: ✅ Fraud proven → balance frozen → only agent can withdraw
    -- CONFIDENCE: code-inspection
    for dispute in PrepaidDispute:
        dispute.success implies balance.disputed = true
        dispute.success implies balance.pending_claim_count = 0
}

-- ==========================================================
-- SUMMARY
-- ==========================================================

-- Total invariants checked: 38 (was 25; +5 S8, +3 fee events, +5 prepaid v0.2)
-- Verified against code: 38/38
-- Confidence breakdown: 6 mutation-tested (strong), 32 code-inspection (weak), 0 independent-derivation
-- Mutation-tested invariants: FeeNeverExceedsAmount, EscrowNoFeeOnRefund,
--   StreamTotalClaimedBounded, StreamAccrualOverflowSafe, PrepaidClaimedCallsMonotonic,
--   PrepaidExtractionBounded — all 6 mutations CAUGHT (2026-04-11)
-- Findings resolved: 1 (escrow release deadline-gated — found and fixed by allium, 2026-03-28)
-- Open questions: 0
--
-- The contracts are well-hardened. Key strengths:
-- 1. u128 overflow protection everywhere (Cetus lesson internalized)
-- 2. Consistent fee calculation via shared math module
-- 3. Registry ownership check prevents revocation bypass
-- 4. Time-shift pattern in stream resume prevents pause→close theft
-- 5. Dispute grace period with bounded clamp prevents griefing
-- 6. Invoice consumption = Move-native replay protection (no registry needed)
-- 7. S8 causal-binding: blake2b-256 digest verification, offline, all 5 adapters (added 2026-04-11)
-- 8. Fee event verification: facilitators verify fees from emitted events, not PTB args (added 2026-04-11)
-- 9. Prepaid v0.2 fraud proofs: Ed25519 signed receipts + dispute window (added 2026-04-11)
